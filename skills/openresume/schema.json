{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "openResume Document",
  "description": "Canonical schema for openResume document format (version 1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "document",
    "profile",
    "sectionOrder",
    "experience",
    "education",
    "projects",
    "skills",
    "certifications"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1],
      "description": "Resume Studio schema format version. Must be exactly 1."
    },
    "document": {
      "$ref": "#/definitions/DocumentConfig",
      "description": "Document-level metadata and presentation configuration."
    },
    "profile": {
      "$ref": "#/definitions/ProfileConfig",
      "description": "Identity and contact details."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "description": "Optional concise professional summary paragraph (2-3 sentences max).",
      "x-guidance": {
        "recommendedMinWords": 25,
        "recommendedMaxWords": 50,
        "recommendedMinChars": 140,
        "recommendedMaxChars": 350,
        "advice": "Keep summary concise (2-3 sentences max, under 50 words). Focus strictly on domain expertise, core skills, and value. Zero generic filler or buzzwords."
      }
    },
    "sectionOrder": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "description": "Rendering order of sections. Exactly all six section identifiers must appear once.",
      "items": {
        "$ref": "#/definitions/SectionId"
      }
    },
    "experience": {
      "type": "array",
      "maxItems": 12,
      "description": "Chronological professional work history.",
      "x-guidance": {
        "recommendedMinItems": 2,
        "recommendedMaxItems": 4,
        "advice": "2 to 4 relevant positions highlighting recent impactful experience."
      },
      "items": {
        "$ref": "#/definitions/ExperienceItem"
      }
    },
    "education": {
      "type": "array",
      "maxItems": 6,
      "description": "Academic qualifications and degrees.",
      "x-guidance": {
        "recommendedMinItems": 1,
        "recommendedMaxItems": 3,
        "advice": "1 to 3 educational achievements."
      },
      "items": {
        "$ref": "#/definitions/EducationItem"
      }
    },
    "projects": {
      "type": "array",
      "maxItems": 8,
      "description": "Selected key projects.",
      "x-guidance": {
        "recommendedMinItems": 1,
        "recommendedMaxItems": 3,
        "advice": "1 to 3 relevant projects demonstrating applied skills."
      },
      "items": {
        "$ref": "#/definitions/ProjectItem"
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 12,
      "description": "Categorized professional proficiencies.",
      "x-guidance": {
        "recommendedMinItems": 3,
        "recommendedMaxItems": 5,
        "advice": "3 to 5 skill categories matching target roles."
      },
      "items": {
        "$ref": "#/definitions/SkillGroup"
      }
    },
    "certifications": {
      "type": "array",
      "maxItems": 12,
      "description": "Professional certifications and licenses.",
      "x-guidance": {
        "recommendedMinItems": 0,
        "recommendedMaxItems": 4,
        "advice": "0 to 4 current industry credentials."
      },
      "items": {
        "$ref": "#/definitions/CertificationItem"
      }
    }
  },
  "definitions": {
    "TemplateId": {
      "type": "string",
      "enum": ["classic", "executive"],
      "description": "Template layout: classic (single-column LaTeX/SWE format) or executive (two-column modern format matching Enhancv layout)."
    },
    "MaxPages": {
      "type": "integer",
      "enum": [1, 2],
      "description": "Page budget ceiling (1 or 2 pages)."
    },
    "AccentColor": {
      "type": "string",
      "enum": ["slate", "navy", "forest", "ocean", "amber"],
      "description": "Restrained accent color for section headings and rules."
    },
    "MarginMode": {
      "type": "string",
      "enum": ["narrow", "normal", "compact", "very-narrow", "custom"],
      "description": "Page margin mode: narrow (10mm, default), normal (14mm), compact/very-narrow (7mm), or custom."
    },
    "PaperSize": {
      "type": "string",
      "enum": ["a4", "letter"],
      "description": "Page paper size format: a4 (210 x 297 mm, International standard) or letter (215.9 x 279.4 mm / 8.5 x 11 in, North American standard)."
    },
    "SectionId": {
      "type": "string",
      "enum": [
        "summary",
        "experience",
        "education",
        "projects",
        "skills",
        "certifications"
      ],
      "description": "Unique identifier for top-level resume sections."
    },
    "DocumentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "template", "maxPages", "accent"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Document title used for editor display and sanitized export filename.",
          "x-guidance": {
            "recommendedMinChars": 20,
            "recommendedMaxChars": 60,
            "advice": "Descriptive title for display and filename export."
          }
        },
        "template": {
          "$ref": "#/definitions/TemplateId"
        },
        "maxPages": {
          "$ref": "#/definitions/MaxPages"
        },
        "accent": {
          "$ref": "#/definitions/AccentColor"
        },
        "margin": {
          "$ref": "#/definitions/MarginMode"
        },
        "paperSize": {
          "$ref": "#/definitions/PaperSize"
        },
        "font": {
          "type": "string",
          "enum": ["jakarta", "inter", "serif", "times", "system"],
          "description": "Primary typography font family: jakarta (Plus Jakarta Sans, recommended for Executive), inter (modern sans), serif (editorial serif), times (Times New Roman), or system."
        },
        "textSize": {
          "type": "string",
          "enum": ["10", "11", "12"],
          "description": "Base document text size in points: 10 (compact), 11 (standard/default), or 12 (large)."
        },
        "customMarginMm": {
          "type": "number",
          "minimum": 4,
          "maximum": 25,
          "description": "Custom page margin in millimeters when margin mode is custom."
        },
        "reduceMargin": {
          "type": "boolean",
          "description": "Optional compact margin mode (boolean legacy flag)."
        }
      }
    },
    "ProfileLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "url"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,47}$",
          "description": "Stable item identifier."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Human-readable label for the link."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Absolute web URL."
        }
      }
    },
    "ProfileConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "links"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Candidate full name."
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Professional headline or target role.",
          "x-guidance": {
            "recommendedMinWords": 5,
            "recommendedMaxWords": 12,
            "recommendedMinChars": 40,
            "recommendedMaxChars": 80,
            "advice": "Concise headline summarizing expertise and target role."
          }
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "description": "Contact email address."
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Contact phone number."
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Geographic location (city, state/region, country)."
        },
        "links": {
          "type": "array",
          "maxItems": 4,
          "description": "Up to 4 professional web links.",
          "x-guidance": {
            "recommendedMinItems": 1,
            "recommendedMaxItems": 3,
            "advice": "1 to 3 relevant professional URLs (e.g. portfolio, GitHub, LinkedIn)."
          },
          "items": {
            "$ref": "#/definitions/ProfileLink"
          }
        }
      }
    },
    "ExperienceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "employer", "role", "start", "bullets"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,47}$",
          "description": "Stable item identifier."
        },
        "employer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Name of employer or organization."
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Job title or role."
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Role location."
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$",
          "description": "Start date in YYYY-MM format."
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$",
          "description": "End date in YYYY-MM format. Forbidden when current is true."
        },
        "current": {
          "type": "boolean",
          "description": "True if this is the current active role."
        },
        "icon": {
          "type": "string",
          "maxLength": 65536,
          "description": "Optional company logo image (safe data URL or URL)."
        },
        "technologies": {
          "type": "string",
          "maxLength": 250,
          "description": "Optional tech stack or technologies subline for the role."
        },
        "subtitle": {
          "type": "string",
          "maxLength": 250,
          "description": "Optional secondary role subtitle or tech stack."
        },
        "bullets": {
          "type": "array",
          "maxItems": 8,
          "description": "Achievement bullet points. Limit to 3-4 concise, high-impact bullets per role for optimal readability.",
          "x-guidance": {
            "recommendedMinItems": 2,
            "recommendedMaxItems": 4,
            "advice": "Keep to 3 to 4 concise bullets per role. Avoid dense text or paragraph walls."
          },
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 360,
            "x-guidance": {
              "recommendedMinWords": 10,
              "recommendedMaxWords": 25,
              "recommendedMinChars": 60,
              "recommendedMaxChars": 160,
              "advice": "Keep bullets to 1-2 lines. Start with an action verb, quantify metrics, and highlight outcome."
            }
          }
        }
      }
    },
    "EducationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "institution", "qualification", "details"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,47}$",
          "description": "Stable item identifier."
        },
        "institution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "University, college, or school."
        },
        "qualification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Degree, diploma, or field of study."
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Institution location."
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$",
          "description": "Start date in YYYY-MM format."
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$",
          "description": "End date in YYYY-MM format."
        },
        "icon": {
          "type": "string",
          "maxLength": 65536,
          "description": "Optional institution logo image (safe data URL or URL)."
        },
        "details": {
          "type": "array",
          "maxItems": 3,
          "description": "Honors, GPA, coursework, or activities.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "ProjectItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "bullets"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,47}$",
          "description": "Stable item identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Project title."
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Role in project (e.g. Creator, Lead)."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Project link or repository."
        },
        "bullets": {
          "type": "array",
          "maxItems": 6,
          "description": "Project achievement bullets.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 360,
            "x-guidance": {
              "recommendedMinWords": 15,
              "recommendedMaxWords": 30,
              "recommendedMinChars": 90,
              "recommendedMaxChars": 180,
              "advice": "Describe project scope, technology used, and measurable results."
            }
          }
        }
      }
    },
    "SkillGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "items"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,47}$",
          "description": "Stable item identifier."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Skill category name (e.g. Languages, Frameworks, Cloud)."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "description": "Individual skills in this category.",
          "x-guidance": {
            "recommendedMinItems": 4,
            "recommendedMaxItems": 8,
            "advice": "4 to 8 skills per category. Avoid skill proficiency bars."
          },
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        }
      }
    },
    "CertificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,47}$",
          "description": "Stable item identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Certification name."
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Issuing organization."
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$",
          "description": "Issue date in YYYY-MM format."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Verification or credential URL."
        }
      }
    }
  }
}
